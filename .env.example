# ---------------------------------------------------------------------------
# 環境変数のテンプレート
#
# ローカル開発:  このファイルを .env.local にコピーして実際の値を入れる
# Vercel:        Project Settings → Environment Variables に同じキーを登録する
#                （Production / Preview / Development すべてに設定すること）
#
# .env.local は .gitignore 済み。実際の値は絶対にコミットしないこと。
# ---------------------------------------------------------------------------

# --- microCMS（PROFILE / MUSIC / VIDEOS / LIVE / NEWS の各ページで使用）-----
# 管理画面 URL が https://example.microcms.io なら "example" を指定する
MICROCMS_SERVICE_DOMAIN=
# microCMS の「APIキー」（GET 権限があれば十分）
MICROCMS_API_KEY=

# --- Gmail 送信設定（/api/contact のお問い合わせフォームで使用）-------------
# 送信元となる Gmail アドレス
GMAIL_USER=
# Google アカウントの「アプリ パスワード」（16桁）。通常のログインパスワードは不可
GMAIL_PASS=

# --- 任意 -------------------------------------------------------------------
# お問い合わせの受信先。未設定の場合は hailrose.work@gmail.com が使われる
# CONTACT_TO_EMAIL=
